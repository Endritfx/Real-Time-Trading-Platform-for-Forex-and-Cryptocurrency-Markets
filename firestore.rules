rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User document
    match /users/{userId} {
      allow read, write: if request.auth != null &&
                         request.auth.uid == userId;

      // Subcollections (trading, etj.)
      match /{document=**} {
        allow read, write: if request.auth != null &&
                           request.auth.uid == userId;
      }
    }

    // Chat sessions
    match /chatSessions/{sessionId} {
      allow read, write: if request.auth != null;
    }
  }
}